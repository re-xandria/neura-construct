<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Template name="Small-Button-Default" src="../../Components/Buttons/Small-Button-Default.uxml"/>
    <ui:Template name="Subtitle-Text" src="/Assets/Figma/Components/Type/Subtitle-Text.uxml"/>
    <ui:Template name="Title-Text" src="/Assets/Figma/Components/Type/Title-Text.uxml"/>
    <Style src="/Assets/Figma/Project-Heartbeat/MainMenu/Main-Menu.uss"/>
    <ui:VisualElement class="main-menu" style="overflow: hidden; background-color: rgb(237, 185, 159);">
        <ui:VisualElement style="display: flex; width: 400px; flex-direction: column; align-items: flex-start; position: absolute; left: 217px; top: 440px;">
            <ui:Instance template="Small-Button-Default" name="startButton" style="flex-shrink: 0; margin-bottom: 15px;">
                <AttributeOverrides element-name="text-0" text="START GAME"/>
            </ui:Instance>
            <ui:Instance template="Small-Button-Default" name="recordButton" style="flex-shrink: 0; margin-bottom: 15px;">
                <AttributeOverrides element-name="text-0" text="RECORD LEVEL"/>
            </ui:Instance>
            <ui:Instance template="Small-Button-Default" name="optionsButton" style="flex-shrink: 0; margin-bottom: 15px;">
                <AttributeOverrides element-name="text-0" text="ACHIEVEMENTS"/>
            </ui:Instance>
            <ui:Instance template="Small-Button-Default" name="achievementsButton" style="flex-shrink: 0; margin-bottom: 15px;">
                <AttributeOverrides element-name="text-0" text="OPTIONS"/>
            </ui:Instance>
            <ui:Instance template="Small-Button-Default" name="exitButton" style="flex-shrink: 0;">
                <AttributeOverrides element-name="text-0" text="EXIT GAME"/>
            </ui:Instance>
        </ui:VisualElement>
        <ui:VisualElement style="width: 817px; height: 147px; position: absolute; left: 217px; top: 180px;">
            <ui:Instance template="Subtitle-Text" class="subtitle-text__i" style="position: absolute; left: 0; top: 0; width: 689.479px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/Rubik-Medium.ttf?fileID=12800000&amp;guid=b2594a86d5cc54b5f845c03ce9759327&amp;type=3#Rubik-Medium&quot;);">
                <AttributeOverrides element-name="text-0" text="PROJECT"/>
