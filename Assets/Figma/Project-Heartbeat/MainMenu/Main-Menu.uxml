            <ui:Instance template="Title-Text" class="title-text__i" style="position: absolute; left: 0; top: 47px; width: 817px; letter-spacing: -5px;">
                <AttributeOverrides element-name="text-0" text="HEARTBEAT"/>
            </ui:Instance>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
