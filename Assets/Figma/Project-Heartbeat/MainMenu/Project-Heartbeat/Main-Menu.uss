.main-menu {
    width: 1920px;
    height: 1080px;
    flex-shrink: 0;
}

.unity-ui-document__root > .main-menu {
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
    width: auto;
    height: auto;
}

.subtitle-text__i > .subtitle-text.subtitle-text.subtitle-text.subtitle-text.subtitle-text.subtitle-text.subtitle-text {
    width: 100%;
}

.subtitle-text__i .subtitle-text__e.subtitle-text__e.subtitle-text__e.subtitle-text__e.subtitle-text__e.subtitle-text__e.subtitle-text__e {
    right: 73.313%;
}

.title-text__i > .title-text.title-text.title-text.title-text.title-text.title-text.title-text {
    width: 100%;
}

.title-text__i .title-text__e.title-text__e.title-text__e.title-text__e.title-text__e.title-text__e.title-text__e {
    right: 19.339%;
}

