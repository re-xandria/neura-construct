<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <Style src="Main-Menu.uss" />
    <Template name="Small-Button-Default" src="Small-Button-Default.uxml" />
    <Template name="Subtitle-Text" src="Subtitle-Text.uxml" />
    <Template name="Title-Text" src="Title-Text.uxml" />
    <ui:VisualElement class="main-menu" style="overflow: hidden; background-color: #EDB99F;">
        <ui:VisualElement style="display: flex; width: 400px; flex-direction: column; align-items: flex-start; position: absolute; left: 217px; top: 440px;">
            <ui:Instance template="Small-Button-Default" style="flex-shrink: 0;">
                <AttributeOverrides element-name="text-0" text="START GAME" />
            </ui:Instance>
            <ui:Instance template="Small-Button-Default" style="flex-shrink: 0;">
                <AttributeOverrides element-name="text-0" text="ACHIEVEMENTS" />
            </ui:Instance>
            <ui:Instance template="Small-Button-Default" style="flex-shrink: 0;">
                <AttributeOverrides element-name="text-0" text="OPTIONS" />
            </ui:Instance>
            <ui:Instance template="Small-Button-Default" style="flex-shrink: 0;">
                <AttributeOverrides element-name="text-0" text="EXIT GAME" />
            </ui:Instance>
        </ui:VisualElement>
        <ui:VisualElement style="width: 817px; height: 147px; position: absolute; left: 217px; top: 180px;">
            <ui:Instance template="Subtitle-Text" class="subtitle-text__i" style="position: absolute; left: 0px; top: 0px; width: 689.479px;">
                <AttributeOverrides element-name="text-0" text="PROJECT" />
            </ui:Instance>
            <ui:Instance template="Title-Text" class="title-text__i" style="position: absolute; left: 0px; top: 47px; width: 817px;">
                <AttributeOverrides element-name="text-0" text="HEARTBEAT" />
            </ui:Instance>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
